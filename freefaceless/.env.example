# .env.example — kopyala: Copy-Item .env.example .env (freefaceless/ içinde)
# Hepsi ücretsiz, kredi kartı gerekmez.

# Groq — senaryo üretimi için ücretsiz LLM API.
# Al: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Pexels — b-roll stok video için ücretsiz API.
# Al: https://www.pexels.com/api/
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- CI (GitHub Actions) için ek seçimlik değişkenler ---
# Yerel çalışmada boş bırak; freefaceless/.github workflow'u secrets'tan doldurur.
# YOUTUBE_REFRESH_TOKEN=...
# CLIENT_SECRETS_JSON={"installed": {...}}
